# Public site URL. Used for the sitemap, robots.txt, canonical Open Graph
# URL, and Stripe/OG metadata. Set to the real production domain once
# deployed — defaults to localhost for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# OpenAI API key. Required for the /api/generate route.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Supabase — auth (Google + Email) and database. Required for the
# growth-first launch: signed-in generator, usage analytics, admin
# dashboard. Create a project at https://supabase.com, run the SQL in
# supabase/migrations/*.sql (SQL Editor, in order), and enable the Google
# provider under Authentication > Providers.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, never expose to the browser. Used for
# admin dashboard queries and writing analytics events across all users.
# Find it in Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to view /admin.
ADMIN_EMAILS=

# Optional. Buy Me a Coffee (or similar) link for the friendly "Support
# this project" button. Button is hidden entirely if unset.
NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=

# ============================================================
# Stripe — currently DISABLED in the UI (growth-first launch has no paid
# plan yet). The integration is fully built and kept ready: fill these in
# and re-wire the PremiumUpsell/RecoverAccess components back into
# features/generator/components/GeneratePageClient.tsx whenever Premium
# plans are introduced.
# ============================================================
# Stripe secret key (test or live). Required for /api/checkout and the webhook.
# Get one at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret. Get one by creating an endpoint at
# https://dashboard.stripe.com/webhooks pointing to /api/webhooks/stripe,
# listening for the checkout.session.completed event.
STRIPE_WEBHOOK_SECRET=

# Price IDs from https://dashboard.stripe.com/products.
# STRIPE_PRICE_MONTHLY must be a recurring price ($9/month).
# STRIPE_PRICE_LIFETIME must be a one-time price ($49).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=

# Secret used to sign the Premium/usage cookies so they can't be forged by
# editing cookies in the browser. Required for Premium status and the free
# daily limit to actually be enforced (not just shown in the UI).
# Generate one with: openssl rand -hex 32
COOKIE_SIGNING_SECRET=

# Meta (Facebook) Pixel ID. Optional — when set, funnel milestones
# (Generator Opened, Generate Clicked, Premium Clicked, Purchase Completed)
# are also sent to Facebook as standard events, so ad delivery can optimize
# for conversions and retargeting audiences can be built.
# Get one at https://business.facebook.com/events_manager
NEXT_PUBLIC_FB_PIXEL_ID=
